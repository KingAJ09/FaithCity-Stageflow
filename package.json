{
  "name": "stageflow",
  "version": "0.1.0",
  "description": "Offline-first event timing and production control desktop application",
  "main": "dist-electron/electron/main/main.js",
  "author": "FaithCity Stageflow",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1 --port 4173 --strictPort\" \"wait-on http://127.0.0.1:4173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:4173 NODE_ENV=development electron .\"",
    "build": "tsc -b && vite build && tsc -p electron/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "package": "npm run build && electron-builder",
    "package:win": "npm run build && electron-builder --win nsis portable",
    "package:mac": "npm run build && electron-builder --mac dmg",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "better-sqlite3": "latest",
    "express": "latest",
    "lucide-react": "latest",
    "qrcode": "latest",
    "react": "latest",
    "react-dom": "latest",
    "socket.io": "latest",
    "socket.io-client": "latest",
    "zustand": "latest"
  },
  "devDependencies": {
    "@types/better-sqlite3": "latest",
    "@types/express": "latest",
    "@types/node": "latest",
    "@types/qrcode": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "latest",
    "cross-env": "latest",
    "electron": "^44.6.0",
    "electron-builder": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest",
    "wait-on": "latest"
  },
  "build": {
    "appId": "com.stageflow.desktop",
    "productName": "FaithCity Stageflow",
    "icon": "public/faithcity-icon.png",
    "asar": true,
    "files": [
      "dist/**",
      "dist-electron/**",
      "database/**",
      "package.json"
    ],
    "extraMetadata": {
      "main": "dist-electron/electron/main/main.js"
    },
    "directories": {
      "output": "release/build"
    },
    "win": {
      "icon": "build/faithcity-icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "artifactName": "FaithCity-Stageflow-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "FaithCity-Stageflow-Portable-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.business",
      "artifactName": "FaithCity-Stageflow-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "FaithCity Stageflow"
    }
  }
}
